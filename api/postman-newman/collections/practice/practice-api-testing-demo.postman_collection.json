          "name": "Get All Posts",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('GET posts returns 200', function () { pm.response.to.have.status(200); });",
                  "const posts = pm.response.json();",
                  "pm.test('GET posts returns up to five posts for user 1', function () {",
                  "    pm.expect(posts).to.be.an('array').and.to.have.length.of.at.most(5);",
                  "    posts.forEach(function (post) { pm.expect(post.userId).to.equal(1); });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/posts?userId=1&_limit=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts"
              ],
              "query": [
                {
                  "key": "userId",
                  "value": "1",
                  "description": "Filter posts by user ID"
                },
                {
                  "key": "_limit",
                  "value": "5",
